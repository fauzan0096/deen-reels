# Is file ko `.env` naam se copy kijiye aur values bharein.
# GitHub Actions par ye values Secrets/Variables me daalni hain.

# --- Content ---
CHANNEL_NAME=Deen Reels

# --- Bhasha / awaaz ---
# ur = Urdu likhaai + Urdu awaaz
# hi = Roman (Latin) script + Hindi awaaz (Urdu voice kai lafz galat bolti hai)
VIDEO_LANG=ur
# TTS_RATE=+0%
# VIDEO_LANG=hi ke saath voice: hi-IN-MadhurNeural (female: hi-IN-SwaraNeural)
# VOICE=ur-PK-AsadNeural        # female: ur-PK-UzmaNeural
# PRIVACY=public                 # public | unlisted | private
# DRY_RUN=yes                    # test karte waqt: video banao, post mat karo
# AMBIENCE=no                    # halki background awaaz band karne ke liye
# LOGO=no                        # logo (mohar) band karne ke liye
# HOOK_ZOOM=no                   # shuru ka halka punch-in band karne ke liye

# --- YouTube ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_CATEGORY_ID=27        # 27 = Education

# --- Facebook Page ---
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# --- Instagram (Reels API ko video ka public URL chahiye) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
# PUBLIC_MEDIA_BASE_URL=https://pub-xxxx.r2.dev/deenreels
# META_API_VERSION=v21.0
